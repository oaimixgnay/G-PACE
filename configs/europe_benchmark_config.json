{
  "models": {
    "reaction_norm_kernel": {
      "alpha": 1.0,
      "genotype_components": 32,
      "environment_components": 12,
      "genotype_weight": 1.0,
      "environment_weight": 1.0,
      "interaction_weight": 0.5
    },
    "ceris_jgra": {
